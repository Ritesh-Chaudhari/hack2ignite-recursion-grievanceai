# Grievance AI — environment template.
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Google Gemini API key (required for AI triage; get one free at
# https://aistudio.google.com/apikey). Without it, submissions use a
# keyword-heuristic fallback instead of AI classification.
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string (optional). If omitted, the app automatically
# falls back to a local JSON file store at ./data/grievance-ai-data.json.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_URI=mongodb+srv://Ritesh-Chaudhari:<Ritesh1234>@cluster0.vqpxc0y.mongodb.net/?appName=Cluster0

# JWT signing secret for session cookies (optional; has a dev default).
# AUTH_SECRET=replace-with-a-long-random-string

# Override the Gemini model (optional; default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
